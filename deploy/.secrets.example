# Staging-only split-file companion for /etc/hackos/hackos.secrets.
#
# Production uses the single combined /etc/hackos/hackos.env shown in
# .env.example. Staging deliberately keeps this separate file.
# Never commit real credentials, tokens, certificates, or private keys here.

# Required by the runtime.
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
MINIO_ROOT_PASSWORD=
BETTER_AUTH_SECRET=
S3_SECRET_KEY=

# Optional authenticated SMTP relay.
SMTP_USER=
SMTP_PASS=

# Optional automatic translation providers.
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_API_KEY=

# Optional review/QA fixture workspace.
REVIEW_FIXTURE_PASSWORD=
REVIEW_FIXTURE_DELETION_PIN=

# Optional Apple Wallet signing material; configure the complete block or none.
APPLE_PASS_CERTIFICATE_PEM=
APPLE_PASS_KEY_PEM=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERTIFICATE_PEM=

# Optional APNs Live Activity key (#966): base64 of the .p8; set with APNS_KEY_ID.
APNS_AUTH_KEY_P8=

# Optional Google Wallet signing material; configure the complete block or none.
GOOGLE_WALLET_PRIVATE_KEY_PEM=
