# ─────────────────────────────────────────────────────────────────────────
# Compatibility combined env template — non-secret values shared by an
# instance. The canonical GPULux contract is `.env.example` plus the generated
# `/etc/hackos/hackos.secrets`; keep this file only for older single-file hosts.
# ─────────────────────────────────────────────────────────────────────────

# The deploy workflow overrides IMAGE_TAG with the selected immutable
# sha-<commit> tag. The Compose file fixes both GHCR repositories.
IMAGE_TAG=sha-0000000000000000000000000000000000000000

# Mail provider is fixed at deploy time (DELTA(H52)). Provider-specific
# SECRETS live in the per-instance file; only the non-secret choice is here.
MAIL_PROVIDER=resend
MAIL_FROM_NAME=hackOS
# Optional branded HTML layout customization (H52). Keep defaults if unsure.
MAIL_LAYOUT_BRAND_NAME=hackOS
MAIL_LAYOUT_HEADER_TEXT=hackOS
MAIL_LAYOUT_HEADER_SUBTEXT=
# Defaults to the hackOS brand mark served from WEB_URL. Point at your own
# browser-reachable PNG/JPEG to white-label, or set to "" for the text header.
# MAIL_LAYOUT_LOGO_URL=https://example.org/hackos-logo.png
MAIL_LAYOUT_ACCENT_COLOR=#18181b
MAIL_LAYOUT_BG_COLOR=#f4f4f5
MAIL_LAYOUT_CARD_COLOR=#ffffff
MAIL_LAYOUT_CARD_BORDER_COLOR=#e4e4e7
MAIL_LAYOUT_TEXT_COLOR=#18181b
MAIL_LAYOUT_MUTED_TEXT_COLOR=#71717a
MAIL_LAYOUT_FOOTER_BG_COLOR=#fafafa
MAIL_LAYOUT_CARD_RADIUS=8
MAIL_LAYOUT_MAX_WIDTH=560
MAIL_FOOTER_TEXT=hackOS — this is an automated message.

# Mobile app (H4, H55) — only needed if apps/mobile's scheme is renamed.
MOBILE_APP_SCHEME=hackos

# Observability / sizing (override per instance if one event is larger).
LOG_LEVEL=info
# Temporarily log redacted Expo push ticket IDs/statuses for delivery debugging.
LOG_EXPO_PUSH_TICKETS=false
# Temporarily log redacted mobile push-token registration hints.
LOG_EXPO_PUSH_TOKENS=false
# Explicitly unsafe: log complete push tokens, message payloads, and Expo responses.
LOG_EXPO_PUSH_UNSAFE_DEBUG=false
# The Compose file pins infrastructure image versions, memory limits and
# MinIO_BROWSER itself; they are intentionally not override variables.
