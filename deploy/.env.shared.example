# ─────────────────────────────────────────────────────────────────────────
# SHARED env — non-secret, identical across every hackOS instance.
# Safe to commit a filled copy internally / paste into every instance.
# Copy to .env.shared and adjust once for your organization.
#
# Precedence: values here are overridden by the per-instance .env file when
# both --env-file flags are passed (later file wins). See README.
# ─────────────────────────────────────────────────────────────────────────

# Container image to run. Point IMAGE_REPO at your registry (e.g. a GitHub
# Container Registry path) and pin IMAGE_TAG to a released version — never
# ship ":latest" to production. If you let Dokploy build from source instead,
# these are ignored.
IMAGE_REPO=ghcr.io/your-org/hackos-api
IMAGE_TAG=0.1.0

# Reverse-proxy network that Traefik/Dokploy manages. Dokploy's default is
# "dokploy-network"; change only if your host uses a different proxy net.
PROXY_NETWORK=dokploy-network

# Traefik ACME cert resolver name (as configured in your Dokploy/Traefik).
CERT_RESOLVER=letsencrypt

# Mail provider is fixed at deploy time (DELTA(H52)). Provider-specific
# SECRETS live in the per-instance file; only the non-secret choice is here.
MAIL_PROVIDER=resend
MAIL_FROM_NAME=hackOS

# Observability / sizing (override per instance if one event is larger).
LOG_LEVEL=info
PG_MEM_LIMIT=1g
VALKEY_MEM_LIMIT=512m
MINIO_MEM_LIMIT=1g
API_MEM_LIMIT=512m
WORKER_MEM_LIMIT=512m

# Pin these to concrete released tags for reproducible, auditable deploys.
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
# Keep the MinIO web console off the public internet.
MINIO_BROWSER=off
