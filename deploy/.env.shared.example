# ─────────────────────────────────────────────────────────────────────────
# SHARED env — non-secret, identical across every hackOS instance.
# Safe to commit a filled copy internally / paste into every instance.
# Copy to .env.shared and adjust once for your organization.
#
# Precedence: values here are overridden by the per-instance .env file when
# both --env-file flags are passed (later file wins). See README.
# ─────────────────────────────────────────────────────────────────────────

# Container image to run. Point IMAGE_REPO at your registry (e.g. a GitHub
# Container Registry path) and pin IMAGE_TAG to a released version — never
# ship ":latest" to production. GitHub Actions builds the combined release on
# `staging` or `main` after the corresponding PR is merged. Each release also
# has an immutable `sha-<commit>` tag.
IMAGE_REPO=ghcr.io/your-org/hackos-api
# The web frontend is a separate image/service.
WEB_IMAGE_REPO=ghcr.io/your-org/hackos-web
IMAGE_TAG=main

# Host ports published by the API and web containers. Put TLS and any
# external routing in the host/load-balancer layer.
API_PORT=3000
WEB_PORT=3001
# Set true only when a trusted external reverse proxy is in front of the API.
TRUST_PROXY=false

# Production mail target: Amazon SES through its SMTP interface. The API also
# exists, but this deployment uses the existing SMTP adapter and keeps all SMTP
# settings configurable in the per-instance file.
MAIL_PROVIDER=smtp
MAIL_FROM_NAME=hackOS

# Mobile app (H4, H55) — only needed if apps/mobile's scheme is renamed.
MOBILE_APP_SCHEME=hackos

# Observability / sizing (override per instance if one event is larger).
LOG_LEVEL=info
# Temporarily log redacted Expo push ticket IDs/statuses for delivery debugging.
LOG_EXPO_PUSH_TICKETS=false
# Temporarily log redacted mobile push-token registration hints.
LOG_EXPO_PUSH_TOKENS=false
# Explicitly unsafe: log complete push tokens, message payloads, and Expo responses.
LOG_EXPO_PUSH_UNSAFE_DEBUG=false
PG_MEM_LIMIT=1g
VALKEY_MEM_LIMIT=512m
MINIO_MEM_LIMIT=1g
API_MEM_LIMIT=512m
WORKER_MEM_LIMIT=512m
WEB_MEM_LIMIT=256m

# Pin these to concrete released tags for reproducible, auditable deploys.
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-04-16T18-13-26Z
# Keep the MinIO web console off the public internet.
MINIO_BROWSER=off
