# ─────────────────────────────────────────────────────────────────────────
# PER-INSTANCE env — UNIQUE and SECRET for each hackOS deployment.
# One copy per event/tenant. NEVER commit a filled version. NEVER reuse
# secrets across instances (a leak in one must not compromise another).
#
# Generate the secret values with:  ./deploy/scripts/gen-secrets.sh
# ─────────────────────────────────────────────────────────────────────────

# Instance identity. STACK_NAME must be unique on the host — it namespaces
# the Traefik routers and (as COMPOSE_PROJECT_NAME) the volumes + private
# network. Use lowercase letters, digits and dashes.
STACK_NAME=hackos-event2026
# Private Docker network shared by postgres/valkey/minio/api/worker in
# per-service Dokploy mode. Create it on the host first:
# docker network create hackos-event2026-net
INSTANCE_NETWORK=hackos-event2026-net
# Public hostname Traefik routes to this API (DNS must point at the host).
API_DOMAIN=api.event2026.example.org
# Public hostname for the WEB frontend — its OWN Traefik router, distinct from
# API_DOMAIN. DNS must point at the host. Baked into the web bundle's
# NEXT_PUBLIC_API_URL points at API_DOMAIN, not this.
WEB_DOMAIN=event2026.example.org
# Browser origins allowed to call the API with credentials (web/TV/admin
# apps). Comma-separated, no spaces. Required in production. MUST include
# https://${WEB_DOMAIN} — it also feeds Better Auth's trustedOrigins, so the
# frontend's sign-in isn't rejected with "Invalid origin".
CORS_ORIGINS=https://event2026.example.org,https://admin.event2026.example.org

# Auth signing secret — 32+ random bytes. Rotating it invalidates sessions.
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# Postgres. DATABASE_URL is assembled from these in the compose file.
POSTGRES_USER=hackos
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=hackos

# Valkey password (used by the app and BullMQ; assembled into VALKEY_URL).
VALKEY_PASSWORD=CHANGE_ME_strong_password

# Object storage (MinIO). ROOT_* administers the server; the app uses the
# ACCESS/SECRET pair. For a hardened setup, create a scoped service account
# in MinIO and put its keys in S3_ACCESS_KEY/S3_SECRET_KEY instead of root.
MINIO_ROOT_USER=hackos
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password
S3_ACCESS_KEY=hackos
S3_SECRET_KEY=CHANGE_ME_strong_password
S3_BUCKET=hackos
# Public https host (incl. bucket) objects are served from AND presigned download
# URLs are signed against. REQUIRED in prod — without it the app hands out the
# internal http://minio:9000 host, which the browser can't reach. Point a domain
# at the minio service (:9000, plain http upstream) and set it here:
S3_PUBLIC_URL=https://s3.CHANGE_ME.example.com/hackos

# Mail sender + provider secret. Fill the block for the MAIL_PROVIDER chosen
# in .env.shared; leave the others blank.
MAIL_FROM_ADDRESS=noreply@event2026.example.org
# --- Resend ---
RESEND_API_KEY=
# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# --- Postal ---
POSTAL_URL=
POSTAL_API_KEY=
