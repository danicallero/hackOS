# ─────────────────────────────────────────────────────────────────────────
# PER-INSTANCE/ENVIRONMENT env — UNIQUE and SECRET for each hackOS deployment.
# One copy per event/tenant/environment. NEVER commit a filled version. NEVER
# reuse secrets across environments (a leak in one must not compromise another).
#
# Generate the secret values with:  ./deploy/scripts/gen-secrets.sh
# ─────────────────────────────────────────────────────────────────────────

# Private Docker network shared by postgres/valkey/minio/api/worker when the
# services are launched from separate Compose projects. Create it first:
# docker network create hackos-event2026-net
INSTANCE_NETWORK=hackos-event2026-net
# Public hostname for this API (DNS and any external TLS/routing must point at
# the host).
API_DOMAIN=api.event2026.example.org
# Public hostname for the WEB frontend, distinct from API_DOMAIN. The web
# container exposes these domains through its runtime config, so the shared
# image works in every environment.
WEB_DOMAIN=event2026.example.org
# Browser origins allowed to call the API with credentials (web/TV/admin
# apps). Comma-separated, no spaces. Required in production. MUST include
# https://${WEB_DOMAIN} — it also feeds Better Auth's trustedOrigins, so the
# frontend's sign-in isn't rejected with "Invalid origin".
CORS_ORIGINS=https://event2026.example.org,https://admin.event2026.example.org

# Auth signing secret — 32+ random bytes. Rotating it invalidates sessions.
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# Postgres. DATABASE_URL is assembled from these in the compose file.
POSTGRES_USER=hackos
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=hackos

# Valkey password (used by the app and BullMQ; assembled into VALKEY_URL).
VALKEY_PASSWORD=CHANGE_ME_strong_password

# Object storage (MinIO). ROOT_* administers the server; the app uses the
# ACCESS/SECRET pair. For a hardened setup, create a scoped service account
# in MinIO and put its keys in S3_ACCESS_KEY/S3_SECRET_KEY instead of root.
MINIO_ROOT_USER=hackos
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password
S3_ACCESS_KEY=hackos
S3_SECRET_KEY=CHANGE_ME_strong_password
S3_BUCKET=hackos
# Public https host (incl. bucket) that sponsor LOGOS are served from. Point a
# domain at the minio service (:9000, plain http upstream) and set it here.
# Application file uploads are private and proxied by the API, so they work
# WITHOUT this — it only affects public logo URLs. Without it, logo URLs fall
# back to the internal http://minio:9000 host the browser can't reach.
S3_PUBLIC_URL=https://s3.CHANGE_ME.example.com/hackos

# Mail sender and SMTP relay settings. Production uses Amazon SES's SMTP
# endpoint for the chosen AWS region; local development can use Mailpit or any
# other SMTP relay. SES SMTP credentials are different from AWS access keys.
MAIL_FROM_ADDRESS=noreply@event2026.example.org
# Example SES endpoint: email.eu-west-1.amazonaws.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Wallet passes (H28) — both platforms optional. Leaving a block blank just
# makes that platform's endpoints return 503 instead of blocking deploy.
# Setting SOME but not all of a platform's vars fails at boot instead — fill
# a block completely or not at all. See deploy/README.md#wallet-passes-h28
# for how to obtain and base64-encode each value, and how to rotate a leak.
# --- Apple Wallet ---
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_ORGANIZATION=hackOS
APPLE_PASS_CERTIFICATE_PEM=
APPLE_PASS_KEY_PEM=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERTIFICATE_PEM=
APPLE_APNS_ENVIRONMENT=production
# --- Google Wallet ---
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_EVENT_TICKET_CLASS_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY_PEM=
GOOGLE_WALLET_LOGO_URL=
GOOGLE_WALLET_HERO_IMAGE_URL=
GOOGLE_WALLET_WIDE_LOGO_URL=
GOOGLE_WALLET_BACKGROUND_COLOR=#1f2430
