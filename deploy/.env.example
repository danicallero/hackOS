# Fichero combinado de producción. Staging usa .staging.env.example y
# .secrets.example.
#
# Copia el fichero real a /etc/hackos/hackos.env con permisos 600.

# The CD workflow publishes this exact immutable tag to GHCR. Replace the
# all-zero example with the 40-character commit SHA you want to deploy.
IMAGE_TAG=sha-0000000000000000000000000000000000000000

# Partial releases set these Compose interpolation values at deploy time.
# Leave them unset in the host file: incus-deploy.sh resolves the unchanged
# service from the running containers or its local .image-tags state file.
# API_IMAGE_TAG=
# WEB_IMAGE_TAG=

# Hostnames only, without https://. Caddy terminates TLS and proxies to the
# ports published by the api and web containers. The separate object-storage
# ingress serves public enterprise logos from MinIO's S3 API; it must never
# expose the MinIO console.
API_DOMAIN=api.hackudc.com
WEB_DOMAIN=os.hackudc.com
CORS_ORIGINS=https://os.hackudc.com

# The proxy LXC reaches the hackos LXC over its Incus network. Bind to
# 127.0.0.1 only when the proxy runs on the same host.
PUBLISH_BIND_ADDRESS=0.0.0.0
API_PUBLISH_PORT=3000
WEB_PUBLISH_PORT=3001
S3_PUBLISH_PORT=9000

# Optional shared ingress network. Leave external=false for the normal
# production profile. A staging host that already runs a tunnel/proxy can set
# EDGE_NETWORK_NAME to that existing network and external=true; only api and
# web join it, using the stable aliases api and web.
EDGE_NETWORK_NAME=hackos-edge
EDGE_NETWORK_EXTERNAL=false

# Persistent Incus volume mounted into the hackos LXC. PostgreSQL and MinIO
# use the postgres/ and minio/ subdirectories below this path.
HACKOS_DATA_DIR=/mnt/data

# Object storage. API and worker use the private Compose endpoint below.
# URL pública de enterprises/. Caddy sólo debe permitir ese prefijo.
POSTGRES_USER=hackos
POSTGRES_DB=hackos
MINIO_ROOT_USER=minioadmin
S3_ACCESS_KEY=hackos-app
S3_BUCKET=hackos
S3_REGION=us-east-1
S3_PUBLIC_URL=https://s3.hackudc.com/hackos/

# Optional off-host backups. R2_ENDPOINT is
# https://<account-id>.r2.cloudflarestorage.com.
R2_BACKUPS_ENABLED=false
# Periodic backup schedule managed by infrastructure: disabled, daily, weekly,
# or monthly. R2_BACKUPS_ENABLED must also be true to schedule backups.
R2_BACKUP_FREQUENCY=disabled
R2_ENDPOINT=
R2_BUCKET=
R2_PREFIX=hackos

# Outbound email. SMTP is the supported transport; production can use the
# Amazon SES SMTP endpoint and local development can use Mailpit.
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=noreply@example.org
MAIL_FROM_NAME=hackOS
SMTP_HOST=smtp.example.org
# Optional: TLS certificate hostname when SMTP_HOST is a private IP.
# SMTP_TLS_SERVERNAME=mail.example.org
SMTP_PORT=587
# 587 uses STARTTLS (required by default). For implicit SMTPS on 465, set
# SMTP_PORT=465 and SMTP_SECURE=true instead.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# Optional application settings. Defaults in docker-compose.yml are normally
# sufficient; uncomment only when the deployment needs a different value.
# MOBILE_APP_SCHEME=hackos
# LOG_LEVEL=info
# LOG_EXPO_PUSH_TICKETS=false
# LOG_EXPO_PUSH_TOKENS=false
# LOG_EXPO_PUSH_UNSAFE_DEBUG=false
# DB_POOL_MAX=24
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# SSE_MAX_CONNECTIONS_GLOBAL=2000
# SSE_MAX_CONNECTIONS_PER_TOPIC=500
# SSE_MAX_CONNECTIONS_PER_CLIENT=20
# SSE_WRITE_TIMEOUT_MS=5000
# RATE_LIMIT_SCAN_MAX=120
# RATE_LIMIT_SCAN_WINDOW_SECONDS=60
# RATE_LIMIT_MEAL_BATCH_MAX=60
# RATE_LIMIT_MEAL_BATCH_WINDOW_SECONDS=60
# RATE_LIMIT_SNAPSHOT_MAX=20
# RATE_LIMIT_SNAPSHOT_WINDOW_SECONDS=60
# NOTIFICATION_OUTBOX_BATCH_SIZE=100

# Optional translation provider configuration.
# TRANSLATE_PROVIDER=google
# GOOGLE_TRANSLATE_API_KEY is secret material; keep it in this 0600 file.
# LIBRETRANSLATE_URL=
# LIBRETRANSLATE_API_KEY is secret material; keep it in this 0600 file.

# Optional Wallet identifiers and public branding. Private signing material
# stays in this 0600 file and is passed only to api and worker.
# APPLE_PASS_TYPE_IDENTIFIER=
# APPLE_TEAM_IDENTIFIER=
# APPLE_PASS_ORGANIZATION=hackOS
# APPLE_APNS_ENVIRONMENT=production
# APPLE_PASS_APP_STORE_ID=
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_EVENT_TICKET_CLASS_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WALLET_LOGO_URL=https://example.org/wallet/logo.png
# GOOGLE_WALLET_HERO_IMAGE_URL=https://example.org/wallet/hero.png
# GOOGLE_WALLET_WIDE_LOGO_URL=https://example.org/wallet/wide-logo.png
# GOOGLE_WALLET_BACKGROUND_COLOR=#1f2430

# Required secrets. Replace every CHANGE_ME value before the first deployment.
BETTER_AUTH_SECRET=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
VALKEY_PASSWORD=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# Optional authenticated SMTP relay.
SMTP_USER=
SMTP_PASS=

# Optional automatic translation providers.
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_API_KEY=

# Optional review/QA fixture workspace.
REVIEW_FIXTURE_PASSWORD=
REVIEW_FIXTURE_DELETION_PIN=

# Optional Apple Wallet signing material; configure the complete block or none.
APPLE_PASS_CERTIFICATE_PEM=
APPLE_PASS_KEY_PEM=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERTIFICATE_PEM=

# Optional Google Wallet signing material; configure the complete block or none.
GOOGLE_WALLET_PRIVATE_KEY_PEM=

# Optional Cloudflare R2 backup token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
