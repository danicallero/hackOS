# Shared multi-architecture configuration for /etc/hackos/hackos.env. Use this
# Compose contract on the staging Raspberry Pi and in production inside
# the hackos LXC; linux/amd64 is required and linux/arm64 is retained.
#
# This file intentionally contains no credentials. Keep those in a separate
# chmod 600 file, for example /etc/hackos/hackos.secrets. Pass this file first
# and the secrets file second to docker compose; the second file wins if a key
# is accidentally duplicated.

COMPOSE_PROJECT_NAME=hackos

# The CD workflow publishes this exact immutable tag to GHCR. Replace the
# all-zero example with the 40-character commit SHA you want to deploy.
IMAGE_TAG=sha-0000000000000000000000000000000000000000

# Hostnames only, without https://. Caddy terminates TLS and proxies to the
# ports published by the api and web containers.
API_DOMAIN=api.example.org
WEB_DOMAIN=example.org
CORS_ORIGINS=https://example.org

# The proxy LXC reaches the hackos LXC over its Incus network. Bind to
# 127.0.0.1 only when the proxy runs on the same host (for example staging Pi).
PUBLISH_BIND_ADDRESS=0.0.0.0
API_PUBLISH_PORT=3000
WEB_PUBLISH_PORT=3001

# Object storage. S3_PUBLIC_URL is optional and must be a browser-reachable
# URL managed outside this Compose network; MinIO itself has no host port.
S3_BUCKET=hackos
S3_PUBLIC_URL=

# Outbound email. Use only the provider block you actually configure. SMTP is
# the default because its host/user/password can remain outside this file.
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=noreply@example.org
MAIL_FROM_NAME=hackOS
SMTP_HOST=smtp.example.org
SMTP_PORT=587

# Optional application settings. Defaults in docker-compose.yml are normally
# sufficient; uncomment only when the deployment needs a different value.
# MOBILE_APP_SCHEME=hackos
# LOG_LEVEL=info
# LOG_EXPO_PUSH_TICKETS=false
# LOG_EXPO_PUSH_TOKENS=false
# LOG_EXPO_PUSH_UNSAFE_DEBUG=false
# DB_POOL_MAX=20
# NOTIFICATION_OUTBOX_BATCH_SIZE=100

# Optional translation provider configuration.
# TRANSLATE_PROVIDER=google
# LIBRETRANSLATE_URL=

# Optional email layout configuration.
# MAIL_LAYOUT_BRAND_NAME=hackOS
# MAIL_LAYOUT_HEADER_TEXT=hackOS
# MAIL_LAYOUT_HEADER_SUBTEXT=
# MAIL_LAYOUT_LOGO_URL=https://example.org/email/brand-mark.png
# MAIL_LAYOUT_ACCENT_COLOR=#18181b
# MAIL_LAYOUT_BG_COLOR=#f4f4f5
# MAIL_LAYOUT_CARD_COLOR=#ffffff
# MAIL_LAYOUT_CARD_BORDER_COLOR=#e4e4e7
# MAIL_LAYOUT_TEXT_COLOR=#18181b
# MAIL_LAYOUT_MUTED_TEXT_COLOR=#71717a
# MAIL_LAYOUT_FOOTER_BG_COLOR=#fafafa
# MAIL_LAYOUT_CARD_RADIUS=8
# MAIL_LAYOUT_MAX_WIDTH=560
# MAIL_FOOTER_TEXT=hackOS — this is an automated message.

# Optional public Wallet branding. Private signing material belongs in the
# secrets file and is passed only to api and worker.
# GOOGLE_WALLET_LOGO_URL=https://example.org/wallet/logo.png
# GOOGLE_WALLET_HERO_IMAGE_URL=https://example.org/wallet/hero.png
# GOOGLE_WALLET_WIDE_LOGO_URL=https://example.org/wallet/wide-logo.png
# GOOGLE_WALLET_BACKGROUND_COLOR=#1f2430
