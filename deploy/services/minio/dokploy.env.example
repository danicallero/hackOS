# Paste this into Dokploy: minio service → Environment Variables.
# See deploy/services/postgres/dokploy.env.example for how this resolves and
# what happens if you're not using Dokploy at all.

MINIO_ROOT_USER=${{environment.MINIO_ROOT_USER}}
MINIO_ROOT_PASSWORD=${{environment.MINIO_ROOT_PASSWORD}}
S3_BUCKET=${{environment.S3_BUCKET}}

# Service-only (optional, literal):
# MINIO_BROWSER=off
# MINIO_IMAGE=minio/minio:RELEASE.2025-01-01T00-00-00Z
# MINIO_MC_IMAGE=minio/mc:RELEASE.2025-01-01T00-00-00Z
# MINIO_MEM_LIMIT=1g
