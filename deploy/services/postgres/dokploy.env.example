# Paste this into Dokploy: postgres service → Environment Variables.
# Not a real .env file the compose file reads directly — Dokploy resolves the
# ${{environment.X}} references below into real values (set once on this
# instance's Environment tab, see deploy/README.md) and writes the result to
# the .env it hands to `docker compose`, which then does its normal ${VAR}
# substitution. See docs/env-vars.md#centralizing-values-with-dokploys-projectenvironment-variables.
#
# Not using Dokploy? Ignore this file — plain `docker compose` with a literal
# .env (deploy/.env.instance.example) works unchanged; the compose YAML never
# references ${{...}}, only plain ${VAR}.

POSTGRES_USER=${{environment.POSTGRES_USER}}
POSTGRES_PASSWORD=${{environment.POSTGRES_PASSWORD}}
POSTGRES_DB=${{environment.POSTGRES_DB}}

# Service-only (optional, literal — nothing else reads these, so routing them
# through the Environment tab buys nothing):
# PG_MEM_LIMIT=1g
