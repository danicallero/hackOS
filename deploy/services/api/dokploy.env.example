# Paste this into Dokploy: api service → Environment Variables.
# See deploy/services/postgres/dokploy.env.example for how this resolves and
# what happens if you're not using Dokploy at all.
# Most variables are shared by the `migrate` and `api` containers in this
# compose file. The reviewer-fixture variables near the top are API-only.

POSTGRES_USER=${{environment.POSTGRES_USER}}
POSTGRES_PASSWORD=${{environment.POSTGRES_PASSWORD}}
POSTGRES_DB=${{environment.POSTGRES_DB}}
VALKEY_PASSWORD=${{environment.VALKEY_PASSWORD}}
API_DOMAIN=${{environment.API_DOMAIN}}
WEB_DOMAIN=${{environment.WEB_DOMAIN}}
BETTER_AUTH_SECRET=${{environment.BETTER_AUTH_SECRET}}
CORS_ORIGINS=${{environment.CORS_ORIGINS}}
LOG_LEVEL=${{environment.LOG_LEVEL}}

# App Store review/QA only. Keep unset outside an isolated reviewer deployment.
# The compose file passes these secrets to `api`, not `migrate`.
# REVIEW_FIXTURE_PASSWORD=${{environment.REVIEW_FIXTURE_PASSWORD}}
# REVIEW_FIXTURE_DELETION_PIN=${{environment.REVIEW_FIXTURE_DELETION_PIN}}

# Postgres pool sizing/timeouts (H540) — must match worker's values. Optional,
# sensible defaults baked into docker-compose.yml; uncomment to override.
# DB_POOL_MAX=${{environment.DB_POOL_MAX}}
# DB_IDLE_TIMEOUT_MS=${{environment.DB_IDLE_TIMEOUT_MS}}
# DB_CONNECTION_TIMEOUT_MS=${{environment.DB_CONNECTION_TIMEOUT_MS}}
# DB_STATEMENT_TIMEOUT_MS=${{environment.DB_STATEMENT_TIMEOUT_MS}}
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=${{environment.DB_IDLE_IN_TRANSACTION_TIMEOUT_MS}}

# SSE connection budgets/backpressure (H540, api only). Optional, sensible
# defaults baked into docker-compose.yml; uncomment to override.
# SSE_MAX_CONNECTIONS_GLOBAL=${{environment.SSE_MAX_CONNECTIONS_GLOBAL}}
# SSE_MAX_CONNECTIONS_PER_TOPIC=${{environment.SSE_MAX_CONNECTIONS_PER_TOPIC}}
# SSE_MAX_CONNECTIONS_PER_CLIENT=${{environment.SSE_MAX_CONNECTIONS_PER_CLIENT}}
# SSE_WRITE_TIMEOUT_MS=${{environment.SSE_WRITE_TIMEOUT_MS}}

# Operational scanner rate limits (#538, per staff user, docs/rate-limiting.md).
# Optional, sensible defaults baked into docker-compose.yml; uncomment to override.
# RATE_LIMIT_SCAN_MAX=${{environment.RATE_LIMIT_SCAN_MAX}}
# RATE_LIMIT_SCAN_WINDOW_SECONDS=${{environment.RATE_LIMIT_SCAN_WINDOW_SECONDS}}
# RATE_LIMIT_MEAL_BATCH_MAX=${{environment.RATE_LIMIT_MEAL_BATCH_MAX}}
# RATE_LIMIT_MEAL_BATCH_WINDOW_SECONDS=${{environment.RATE_LIMIT_MEAL_BATCH_WINDOW_SECONDS}}
# RATE_LIMIT_SNAPSHOT_MAX=${{environment.RATE_LIMIT_SNAPSHOT_MAX}}
# RATE_LIMIT_SNAPSHOT_WINDOW_SECONDS=${{environment.RATE_LIMIT_SNAPSHOT_WINDOW_SECONDS}}

S3_ACCESS_KEY=${{environment.S3_ACCESS_KEY}}
S3_SECRET_KEY=${{environment.S3_SECRET_KEY}}
S3_BUCKET=${{environment.S3_BUCKET}}
S3_PUBLIC_URL=${{environment.S3_PUBLIC_URL}}

MAIL_PROVIDER=${{environment.MAIL_PROVIDER}}
MAIL_FROM_ADDRESS=${{environment.MAIL_FROM_ADDRESS}}
MAIL_FROM_NAME=${{environment.MAIL_FROM_NAME}}

# Mail provider block — uncomment only the lines matching MAIL_PROVIDER above:
# RESEND_API_KEY=${{environment.RESEND_API_KEY}}
# POSTAL_URL=${{environment.POSTAL_URL}}
# POSTAL_API_KEY=${{environment.POSTAL_API_KEY}}
# SMTP_HOST=${{environment.SMTP_HOST}}
# SMTP_PORT=${{environment.SMTP_PORT}}
# SMTP_USER=${{environment.SMTP_USER}}
# SMTP_PASS=${{environment.SMTP_PASS}}

# Optional email theming — leave commented to use the built-in defaults:
# MAIL_FOOTER_TEXT=${{environment.MAIL_FOOTER_TEXT}}
# MAIL_LAYOUT_BRAND_NAME=${{environment.MAIL_LAYOUT_BRAND_NAME}}
# MAIL_LAYOUT_HEADER_TEXT=${{environment.MAIL_LAYOUT_HEADER_TEXT}}
# MAIL_LAYOUT_HEADER_SUBTEXT=${{environment.MAIL_LAYOUT_HEADER_SUBTEXT}}
# MAIL_LAYOUT_LOGO_URL=${{environment.MAIL_LAYOUT_LOGO_URL}}
# MAIL_LAYOUT_ACCENT_COLOR=${{environment.MAIL_LAYOUT_ACCENT_COLOR}}
# MAIL_LAYOUT_BG_COLOR=${{environment.MAIL_LAYOUT_BG_COLOR}}
# MAIL_LAYOUT_CARD_COLOR=${{environment.MAIL_LAYOUT_CARD_COLOR}}
# MAIL_LAYOUT_CARD_BORDER_COLOR=${{environment.MAIL_LAYOUT_CARD_BORDER_COLOR}}
# MAIL_LAYOUT_TEXT_COLOR=${{environment.MAIL_LAYOUT_TEXT_COLOR}}
# MAIL_LAYOUT_MUTED_TEXT_COLOR=${{environment.MAIL_LAYOUT_MUTED_TEXT_COLOR}}
# MAIL_LAYOUT_FOOTER_BG_COLOR=${{environment.MAIL_LAYOUT_FOOTER_BG_COLOR}}
# MAIL_LAYOUT_CARD_RADIUS=${{environment.MAIL_LAYOUT_CARD_RADIUS}}
# MAIL_LAYOUT_MAX_WIDTH=${{environment.MAIL_LAYOUT_MAX_WIDTH}}

# Wallet passes (H28) — optional, but all-or-nothing per platform:
# APPLE_PASS_TYPE_IDENTIFIER=${{environment.APPLE_PASS_TYPE_IDENTIFIER}}
# APPLE_TEAM_IDENTIFIER=${{environment.APPLE_TEAM_IDENTIFIER}}
# APPLE_PASS_ORGANIZATION=${{environment.APPLE_PASS_ORGANIZATION}}
# APPLE_PASS_CERTIFICATE_PEM=${{environment.APPLE_PASS_CERTIFICATE_PEM}}
# APPLE_PASS_KEY_PEM=${{environment.APPLE_PASS_KEY_PEM}}
# APPLE_PASS_KEY_PASSPHRASE=${{environment.APPLE_PASS_KEY_PASSPHRASE}}
# APPLE_WWDR_CERTIFICATE_PEM=${{environment.APPLE_WWDR_CERTIFICATE_PEM}}
# APPLE_APNS_ENVIRONMENT=${{environment.APPLE_APNS_ENVIRONMENT}}
# APPLE_PASS_APP_STORE_ID=${{environment.APPLE_PASS_APP_STORE_ID}}
# GOOGLE_WALLET_ISSUER_ID=${{environment.GOOGLE_WALLET_ISSUER_ID}}
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=${{environment.GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL}}
# GOOGLE_WALLET_PRIVATE_KEY_PEM=${{environment.GOOGLE_WALLET_PRIVATE_KEY_PEM}}

# Optional: auto-translate for H50 announcement content. TRANSLATE_PROVIDER
# picks Google Cloud Translation (default) or a self-hosted LibreTranslate
# instance; unset/misconfigured means manual-only translation entry
# everywhere. Fill only the block matching your chosen provider.
# TRANSLATE_PROVIDER=${{environment.TRANSLATE_PROVIDER}}
# GOOGLE_TRANSLATE_API_KEY=${{environment.GOOGLE_TRANSLATE_API_KEY}}
# LIBRETRANSLATE_URL=${{environment.LIBRETRANSLATE_URL}}
# LIBRETRANSLATE_API_KEY=${{environment.LIBRETRANSLATE_API_KEY}}

# Mobile app (H4, H55) — only needed if apps/mobile's scheme is renamed from
# the default "hackos":
# MOBILE_APP_SCHEME=${{environment.MOBILE_APP_SCHEME}}

# Service-only (optional, literal — sensible defaults in the compose file):
# STACK_NAME=hackos-event2026
# PROXY_NETWORK=dokploy-network
# CERT_RESOLVER=letsencrypt
# IMAGE_REPO=hackos-api
# IMAGE_TAG=latest
# API_MEM_LIMIT=512m
