# Paste this into Dokploy: web service → Environment Variables.
#
# API_DOMAIN and WEB_DOMAIN are runtime container values. The shared web image
# serves /runtime-config.js from them, so changing an environment's domains
# does not require rebuilding the image.

API_DOMAIN=${{environment.API_DOMAIN}}
WEB_DOMAIN=${{environment.WEB_DOMAIN}}
WEB_IMAGE_REPO=${{environment.WEB_IMAGE_REPO}}
IMAGE_TAG=${{environment.IMAGE_TAG}}

# Service-only (optional, literal):
# STACK_NAME=hackos-event2026
# PROXY_NETWORK=dokploy-network
# CERT_RESOLVER=letsencrypt
# WEB_MEM_LIMIT=256m
