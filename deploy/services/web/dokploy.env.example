# Paste this into Dokploy: web service → Environment Variables.
#
# API_DOMAIN here is consumed as a BUILD ARG (see the `build.args` block in
# docker-compose.yml), not a runtime container env var — NEXT_PUBLIC_API_URL
# is baked into the JS bundle at image build time. If your Dokploy build
# step reads variables from this same box (it does, for Compose builds),
# this reference is what makes that work; changing it means rebuilding the
# image, not just restarting the container.

API_DOMAIN=${{environment.API_DOMAIN}}
WEB_DOMAIN=${{environment.WEB_DOMAIN}}

# Service-only (optional, literal):
# STACK_NAME=hackos-event2026
# PROXY_NETWORK=dokploy-network
# CERT_RESOLVER=letsencrypt
# WEB_IMAGE_REPO=hackos-web
# IMAGE_TAG=latest
# WEB_MEM_LIMIT=256m
