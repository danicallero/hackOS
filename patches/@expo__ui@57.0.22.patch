+/// hackOS patch (#966): a live countdown with units, `2h 34m` from one hour
+/// and `34m 21s` below it (`short`: `2h` / `34m`; `long`: `2h 34m 21s` from
+/// one hour), never `H:MM:SS`.
+///
+/// Only timer text ticks inside a Live Activity (unit format styles render
+/// once and freeze, custom ones are redacted), so each number is one field
+/// cut out of a live `Text(timerInterval:)`: the timer (`H:MM:SS` or `M:SS`)
+/// is trailing-aligned in a wide frame, shifted right by the width of what
+/// follows the field and clipped to the field's digits. Monospaced digits
+/// keep every field at a fixed offset from the trailing edge. The units are
+/// static text. The form is chosen when the Live Activity renders; the API
+/// updates it when the hour boundary passes.
+struct CompactCountdown: View {
+  let end: Date
+  let short: Bool
+  var long = false
+  let size: Double
+  let bold: Bool
+
+  private var uiFont: UIFont {
+    UIFont.monospacedDigitSystemFont(ofSize: size, weight: bold ? .bold : .semibold)
+  }
+  private var font: Font { .system(size: size, weight: bold ? .bold : .semibold) }
+  private func advance(_ s: String) -> CGFloat {
+    (s as NSString).size(withAttributes: [.font: uiFont]).width
+  }
+  private var digit: CGFloat { advance("0000000000") / 10 }
+  private var colon: CGFloat { advance(":") }
+
+  /// One field of the live timer: `skip` is the width that follows it.
+  private func field(skip: CGFloat, digits: Int) -> some View {
+    Text(timerInterval: Date.now...max(Date.now, end), countsDown: true)
+      .font(font)
+      .monospacedDigit()
+      .lineLimit(1)
+      .multilineTextAlignment(.trailing)
+      .frame(width: 400, alignment: .trailing)
+      .offset(x: skip)
+      .frame(width: ceil(CGFloat(digits) * digit), alignment: .trailing)
+      .clipped()
+  }
+
+  private func unit(_ text: String) -> some View {
+    Text(text).font(font).lineLimit(1).fixedSize()
+  }
+
+  var body: some View {
+    let left = end.timeIntervalSinceNow
+    HStack(spacing: 0) {
+      if left >= 3600 {
+        field(skip: 2 * colon + 4 * digit, digits: left >= 36000 ? 2 : 1)
+        unit(short ? "h" : "h ")
+        if !short {
+          field(skip: colon + 2 * digit, digits: 2)
+          unit(long ? "m " : "m")
+          if long {
+            field(skip: 0, digits: 2)
+            unit("s")
+          }
+        }
+      } else {
+        field(skip: colon + 2 * digit, digits: left >= 600 ? 2 : 1)
+        unit(short ? "m" : "m ")
+        if !short {
+          field(skip: 0, digits: 2)
+          unit("s")
+        }
+      }
+    }
+    .fixedSize()
+  }
+}
