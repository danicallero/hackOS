+struct CompactCountdownRow: View {
+  let end: Date
+  let size: Double
+  let bold: Bool
+  let short: Bool
+  let reduced: Bool
+
+  private var uiFont: UIFont {
+    UIFont.monospacedDigitSystemFont(ofSize: size, weight: bold ? .bold : .semibold)
+  }
+  private var font: Font { .system(size: size, weight: bold ? .bold : .semibold) }
+  private func advance(_ s: String) -> CGFloat {
+    (s as NSString).size(withAttributes: [.font: uiFont]).width
+  }
+  private var digit: CGFloat { advance("0000000000") / 10 }
+  private var colon: CGFloat { advance(":") }
+  private func digitsWidth(_ count: Int) -> CGFloat { ceil(CGFloat(count) * digit) }
+
+  /// One field of the live timer: `skip` is the width that follows it.
+  private func field(skip: CGFloat, width: CGFloat, scale: Double = 1) -> some View {
+    Text(timerInterval: Date.now...max(Date.now, end), countsDown: true)
+      .font(scale == 1 ? font : .system(size: size * scale, weight: .bold))
+      .monospacedDigit()
+      .lineLimit(1)
+      .multilineTextAlignment(.trailing)
+      .frame(width: 400 * scale, alignment: .trailing)
+      .offset(x: skip)
+      .frame(width: width, alignment: .trailing)
+      .clipped()
+  }
+
+  private func unit(_ text: String, scale: Double = 1, bold: Bool = false) -> some View {
+    Text(text)
+      .font(scale == 1 ? font : .system(size: size * scale, weight: bold ? .bold : .semibold))
+      .lineLimit(1).fixedSize()
+  }
+
+  var body: some View {
+    let left = max(0, end.timeIntervalSinceNow)
+    // The stacked form is as wide as its widest line: the  label is wider
+    // than a one-digit number and was clipped at the island's edge.
+    let seconds = left <= 30 && !reduced
+    let stackWidth = seconds
+      ? digitsWidth(left >= 10 ? 2 : 1) * 1.35
+      : max(digitsWidth(left >= 600 ? 2 : 1) * 1.35, ceil(advance("min") * 0.9) + 8)
+    HStack(spacing: 0) {
+      if short && left < 3600 {
+        // Compact island, Luma style: a big number over a small unit label
+        // (`41` over `min`). Colon notation keeps the last five minutes.
+        VStack(spacing: -2) {
+          if seconds {
+            // The last half minute: just the seconds going down, 30, 29, 28…
+            field(skip: 0, width: digitsWidth(left >= 10 ? 2 : 1) * 1.35, scale: 1.35)
+          } else if left < 60 {
+            unit("<1", scale: 1.35, bold: true)
+            unit("min", scale: 0.72)
+          } else {
+            field(skip: (colon + 2 * digit) * 1.35, width: digitsWidth(left >= 600 ? 2 : 1) * 1.35, scale: 1.35)
+            unit("min", scale: 0.72)
+          }
+        }
+        // A small inset from the island's rounded corner, which cut the first stroke of the label.
+        .frame(width: stackWidth + 4, alignment: .trailing)
+      } else if left >= 3600 {
+        // `2h 34m` (also the compact island's form past an hour); minutes-of-hour under ten drop their zero: `1h 5m`.
+        let shortMinutes = (Int(left) % 3600) / 60 < 10
+        field(skip: 2 * colon + 4 * digit, width: digitsWidth(left >= 36000 ? 2 : 1))
+        unit("h ")
+        field(skip: colon + 2 * digit, width: digitsWidth(shortMinutes ? 1 : 2))
+        unit("m")
+      } else if left < 60 {
+        if reduced {
+          unit("<1m")
+        } else {
+          field(skip: 0, width: digitsWidth(left >= 10 ? 2 : 1))
+          unit("s")
+        }
+      } else if left <= 300 && !reduced {
+        // Colon notation (`4:05`) is where the zero padding belongs; the
+        // native timer text is already `M:SS` here.
+        field(skip: 0, width: ceil(3 * digit + colon))
+      } else {
+        field(skip: colon + 2 * digit, width: digitsWidth(left >= 600 ? 2 : 1))
+        unit("m")
+      }
+    }
+    .fixedSize()
+  }
+}
