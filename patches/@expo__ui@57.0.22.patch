+/// #966: live countdown, minute precision until the last five minutes. A unit
+/// never carries a leading zero (`1h 5m`, `9m`, `9s`); only colon notation is
+/// zero-padded (`4:05`), which the native timer draws itself. The API and the
+/// app send an update at each width boundary (hour, minutes-of-hour 10, ten
+/// minutes, five minutes, a minute, ten seconds); only timer Text ticks in
+/// Live Activities, so each numeric field is clipped from that live source.
+/// Reduced luminance removes the seconds and their unit entirely.
+struct CompactCountdown: View {
+  let end: Date
+  let size: Double
+  let bold: Bool
+  let short: Bool
+  @Environment(\.isLuminanceReduced) private var reduced
+
+  private func row(_ scale: Double) -> some View {
+    CompactCountdownRow(end: end, size: size * scale, bold: bold, short: short, reduced: reduced)
+  }
+
+  var body: some View {
+    if short {
+      // One unit at one size: scaling it down to the island's slot made it
+      // unreadable on the vertical island of a foldable.
+      row(1)
+    } else {
+      ViewThatFits(in: .horizontal) {
+        row(1)
+        row(0.88)
+        row(0.76)
+        row(0.6)
+      }
+    }
+  }
+}
