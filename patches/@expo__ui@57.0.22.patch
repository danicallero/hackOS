+/// #966: live countdown, minute precision until the last five minutes. A unit
+/// never carries a leading zero (`1h 5m`, `9m`, `9s`); only colon notation is
+/// zero-padded (`4:05`), which the native timer draws itself. The API and the
+/// app send an update at each width boundary (hour, minutes-of-hour 10, ten
+/// minutes, five minutes, a minute, ten seconds); only timer Text ticks in
+/// Live Activities, so each numeric field is clipped from that live source.
+/// Reduced luminance removes the seconds and their unit entirely.
+struct CompactCountdown: View {
+  let end: Date
+  let size: Double
+  let bold: Bool
+  @Environment(\.isLuminanceReduced) private var reduced
+
+  private func row(_ scale: Double) -> some View {
+    CompactCountdownRow(end: end, size: size * scale, bold: bold, reduced: reduced)
+  }
+
+  var body: some View {
+    ViewThatFits(in: .horizontal) {
+      row(1)
+      row(0.88)
+      row(0.76)
+      row(0.6)
+    }
+  }
+}
+
+struct CompactCountdownRow: View {
+  let end: Date
+  let size: Double
+  let bold: Bool
+  let reduced: Bool
+
+  private var uiFont: UIFont {
+    UIFont.monospacedDigitSystemFont(ofSize: size, weight: bold ? .bold : .semibold)
+  }
+  private var font: Font { .system(size: size, weight: bold ? .bold : .semibold) }
+  private func advance(_ s: String) -> CGFloat {
+    (s as NSString).size(withAttributes: [.font: uiFont]).width
+  }
+  private var digit: CGFloat { advance("0000000000") / 10 }
+  private var colon: CGFloat { advance(":") }
+  private func digitsWidth(_ count: Int) -> CGFloat { ceil(CGFloat(count) * digit) }
+
+  /// One field of the live timer: `skip` is the width that follows it.
+  private func field(skip: CGFloat, width: CGFloat) -> some View {
+    Text(timerInterval: Date.now...max(Date.now, end), countsDown: true)
+      .font(font)
+      .monospacedDigit()
+      .lineLimit(1)
+      .multilineTextAlignment(.trailing)
+      .frame(width: 400, alignment: .trailing)
+      .offset(x: skip)
+      .frame(width: width, alignment: .trailing)
+      .clipped()
+  }
+
+  private func unit(_ text: String) -> some View {
+    Text(text).font(font).lineLimit(1).fixedSize()
+  }
+
+  var body: some View {
+    let left = max(0, end.timeIntervalSinceNow)
+    HStack(spacing: 0) {
+      if left >= 3600 {
+        // `2h 34m`; minutes-of-hour under ten drop their zero: `1h 5m`.
+        let shortMinutes = (Int(left) % 3600) / 60 < 10
+        field(skip: 2 * colon + 4 * digit, width: digitsWidth(left >= 36000 ? 2 : 1))
+        unit("h ")
+        field(skip: colon + 2 * digit, width: digitsWidth(shortMinutes ? 1 : 2))
+        unit("m")
+      } else if left < 60 {
+        if reduced {
+          unit("<1m")
+        } else {
+          field(skip: 0, width: digitsWidth(left >= 10 ? 2 : 1))
+          unit("s")
+        }
+      } else if left <= 300 && !reduced {
+        // Colon notation (`4:05`) is where the zero padding belongs; the
+        // native timer text is already `M:SS` here.
+        field(skip: 0, width: ceil(3 * digit + colon))
+      } else {
+        field(skip: colon + 2 * digit, width: digitsWidth(left >= 600 ? 2 : 1))
+        unit("m")
+      }
+    }
+    .fixedSize()
+  }
+}
