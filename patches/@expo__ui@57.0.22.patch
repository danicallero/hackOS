+
+/// hackOS (#966): the compact Live Activity countdown, `1h 20m` / `10m` /
+/// `59s` (`1h` with `maxUnits` 1), mirroring `formatLiveCountdown`
+/// (`@hackos/shared/live-activities`).
+/// Its input is `TimeDataSource.durationOffset(to:)`, which is negative while
+/// the date is ahead (now − date), so the time left is the negated input.
+/// Discrete, so the system schedules each change: every minute, every second
+/// in the last one.
+@available(iOS 18.0, tvOS 18.0, *)
+public struct CompactCountdownFormatStyle: DiscreteFormatStyle {
+  public var hour: String
+  public var minute: String
+  public var second: String
+  public var maxUnits: Int
+
+  public init(hour: String, minute: String, second: String, maxUnits: Int = 2) {
+    self.hour = hour
+    self.minute = minute
+    self.second = second
+    self.maxUnits = maxUnits
+  }
+
+  public func format(_ offset: Duration) -> String {
+    let seconds = Self.secondsLeft(offset)
+    if seconds < 60 { return "\(seconds)\(second)" }
+    let minutes = seconds / 60
+    if minutes < 60 { return "\(minutes)\(minute)" }
+    let rest = minutes % 60
+    return rest == 0 || maxUnits < 2
+      ? "\(minutes / 60)\(hour)" : "\(minutes / 60)\(hour) \(rest)\(minute)"
+  }
+
+  // The text is constant while the time left is in [lower, lower + step):
+  // whole seconds under a minute, whole minutes above. Time runs towards a
+  // larger offset, so `after` is the next change and `before` the previous.
+  public func discreteInput(after offset: Duration) -> Duration? {
+    let lower = Self.lowerBound(offset)
+    return lower > 0 ? .seconds(-lower) + .nanoseconds(1) : nil
+  }
+
+  public func discreteInput(before offset: Duration) -> Duration? {
+    let seconds = Self.secondsLeft(offset)
+    return .seconds(-(seconds < 60 ? seconds + 1 : (seconds / 60 + 1) * 60))
+  }
+
+  private static func secondsLeft(_ offset: Duration) -> Int64 {
+    offset >= .zero ? 0 : (Duration.zero - offset).components.seconds
+  }
+
+  private static func lowerBound(_ offset: Duration) -> Int64 {
+    let seconds = secondsLeft(offset)
+    return seconds < 60 ? seconds : seconds / 60 * 60
+  }
+}
