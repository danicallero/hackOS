+import {useContext, useMemo, useState, useSyncExternalStore} from 'react';
+
+// Fabric caches each paragraph's Yoga measurement on the shadow nodes React
+// retains. When the system text size changes, only the native branch is
+// re-measured, so the next React commit restores frames measured at the old
+// font scale while the glyphs render at the new one, clipping every label.
+// Keying root paragraphs by the current font scale remounts them once per
+// change, so they are measured afresh at the scale they are drawn with.
+let currentFontScale: ?number = null;
+let fontScaleSubscription: ?{remove: () => void} = null;
+const fontScaleListeners: Set<() => void> = new Set();
+
+function getFontScale(): number {
+  if (currentFontScale == null || fontScaleSubscription == null) {
+    currentFontScale = Dimensions.get('window').fontScale;
+  }
+  return currentFontScale;
+}
+
+function subscribeToFontScale(listener: () => void): () => void {
+  fontScaleListeners.add(listener);
+  if (fontScaleSubscription == null) {
+    currentFontScale = Dimensions.get('window').fontScale;
+    fontScaleSubscription = Dimensions.addEventListener('change', ({window}) => {
+      if (window.fontScale === currentFontScale) {
+        return;
+      }
+      currentFontScale = window.fontScale;
+      fontScaleListeners.forEach(notify => notify());
+    });
+  }
+  return () => {
+    fontScaleListeners.delete(listener);
+  };
+}
 
 export type {TextProps} from './TextProps';
 
