{
  "name": "hackos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @hackos/api --filter @hackos/web dev",
    "dev:api": "pnpm --filter @hackos/api dev",
    "dev:web": "pnpm --filter @hackos/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "migrate": "pnpm --filter @hackos/api migrate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "darwin",
        "linux"
      ],
      "cpu": [
        "arm64",
        "x64"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "typescript": "^6.0.3"
  }
}
