# Copy to apps/api/.env for local overrides. Defaults in src/config.ts
# already match docker-compose.yml, so an empty .env works.
DATABASE_URL=postgres://hackos:hackos@localhost:5433/hackos
VALKEY_URL=redis://localhost:6379
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-secret-change-me
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=hackos
S3_SECRET_KEY=hackos-secret
S3_BUCKET=hackos
# Browser-reachable base objects are served from. Leave blank in local dev
# (defaults to S3_ENDPOINT/S3_BUCKET); in prod set to the public https host,
# e.g. https://s3.yourdomain.com/hackos — else stored file/logo URLs won't load.
# S3_PUBLIC_URL=
# docker-compose provisions the bucket from these (minio-init); override in prod:
# MINIO_ROOT_USER=hackos
# MINIO_ROOT_PASSWORD=change-me
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional email layout/footer customization:
# MAIL_FOOTER_TEXT=You are receiving this automated email because ...
# MAIL_LAYOUT_ACCENT_COLOR=#4f46e5
