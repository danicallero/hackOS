<?xml version="1.0" encoding="utf-8"?>
<!-- #966: Live Update card colours (the iOS Live Activity palette). Night
     variants in values-night; RemoteViews resolve them in the system's
     configuration, so the card follows the shade's light/dark mode. -->
<resources>
  <color name="hackos_lu_primary">#FF1C1C1E</color>
  <color name="hackos_lu_secondary">#FF6C6C70</color>
  <color name="hackos_lu_accent">#FF007AFF</color>
  <color name="hackos_lu_go">#FF248A3D</color>
  <color name="hackos_lu_neutral">#FF8E8E93</color>
  <!-- The travelled part of a track (Maps style: grey behind, colour ahead). -->
  <color name="hackos_lu_travelled">#FFC7C7CC</color>
  <color name="hackos_lu_track">#FFE5E5EA</color>
  <color name="hackos_lu_on_accent">#FFFFFFFF</color>
</resources>
