{
  "expo": {
    "name": "hackOS",
    "slug": "hackos",
    "description": "The HackUDC participant and event operations app.",
    "version": "1.0.4",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "hackos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon-ios.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.hackudc.os",
      "buildNumber": "2",
      "appleTeamId": "P88YRBYY9T",
      "associatedDomains": ["webcredentials:os.hackudc.com"],
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.pass-type-identifiers": ["$(TeamIdentifierPrefix)*"],
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "UISupportedInterfaceOrientations": ["UIInterfaceOrientationPortrait"],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f5f5f7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "package": "com.hackudc.os",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f5f5f7"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "hackOS scans ticket and badge QR codes for event check-in and attendance.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "hackOS reads the photo you choose as your profile picture.",
          "cameraPermission": "hackOS takes a photo to use as your profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.hackudc.os",
          "enablePushNotifications": true,
          "frequentUpdates": true
        }
      ],
      "./plugins/withStripDsymPaths.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "67dfb15e-eb03-441d-ba61-927e7e1defab"
      }
    },
    "owner": "hack-os"
  }
}
