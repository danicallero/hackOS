    "@fastify/multipart": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@hackos/shared": "workspace:*",
    "archiver": "^8.0.0",
    "better-auth": "^1.6.23",
    "bullmq": "^5.79.2",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.9.0",
    "fastify-plugin": "^6.0.0",
