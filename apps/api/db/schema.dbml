  is_seeded boolean [not null, default: `false`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  deleted_at "timestamp with time zone" [note: 'H8: soft-delete marker. Non-null excludes the role from capability resolution (user_effective_capabilities), from default GET /api/roles listings, and from every "highest role" / wildcard-holder computation, as if the user held no such role. A deleted role\'s position becomes available for reuse (see roles_position_idx below); POST .../restore 409s only if a still-live role has since taken that exact slot.']

  Note: 'H8: the authorization truth. is_visible marks a role eligible to be shown as a user\'s public role; is_protected is the enforced (not informational) lockout — every HTTP mutation route refuses a role with is_protected = true outright (role-authority.ts assertNotProtectedRole), regardless of the actor\'s own capabilities; it is never settable via POST/PATCH /api/roles, only by direct DB/CLI action (only system:superadmin carries it today, see scripts/grant-superadmin.mjs and create-superadmin.ts); is_seeded marks a role that came from a seed migration rather than being created by an admin.'
}

Table room_enterprises {
  room_id integer [pk, not null]
  enterprise_id integer [not null]
  assigned_at "timestamp with time zone" [not null, default: `now()`]
  assigned_by integer
}

Table room_queue_groups {
  room_id integer [unique, not null]
  assigned_at "timestamp with time zone" [not null, default: `now()`]
  assigned_by integer
  queue_group_id integer [not null]

  indexes {
  (room_id, queue_group_id) [pk]
  }
}

Table room_queue_state {
  room_id integer [pk, not null]
  is_paused boolean [not null, default: `true`]
  max_in_waiting_area integer [not null, default: `2`]
  desired_minutes_per_team integer [not null, default: `8`]
  started_at "timestamp with time zone"
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

Table rooms {
  id integer [pk, increment, not null]
  name text [not null]
  slug text [unique, not null]
  location text
  status text [not null, default: `'paused'::text`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

Table scanner_revoked_badges {
  credential_digest text [pk, not null, note: 'HMAC-SHA256 of a retired badge credential under the deployment secret.']
  revoked_at "timestamp with time zone" [not null, default: `clock_timestamp()`]

  Note: 'H54 unlinked keyed-digest denylist for permanently retired badge credentials; raw badges are never retained.'
}

Table scanner_revoked_tickets {
  credential_digest text [pk, not null, note: 'HMAC-SHA256 of a retired ticket credential under the deployment secret.']
  revoked_at "timestamp with time zone" [not null, default: `clock_timestamp()`]

  Note: 'H54 unlinked keyed-digest denylist for permanently retired ticket credentials; raw tokens are never retained.'
}

Table schedule {
  id integer [pk, increment, not null]
  title text [not null]
  description text
  location text
  type text
  starts_at "timestamp with time zone" [not null]
  ends_at "timestamp with time zone" [not null]
  visibility text [not null, default: `'hidden'::text`]
  publish_at "timestamp with time zone"
  reminded_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  requires_scan boolean [not null, default: `false`]
  audiences "text[]" [not null, default: `'{}'::text[]`]
  contact_note text
  notes text
  primary_language text [not null, default: `'es'::text`]
  title_i18n jsonb
  description_i18n jsonb
}

Table schedule_owners {
  id integer [pk, increment, not null]
  schedule_id integer [not null]
  user_id integer
  assigned_by integer
  assigned_at "timestamp with time zone" [not null, default: `now()`]
  free_text_name text

  indexes {
  (schedule_id, user_id) [unique]
  }
}

Table sessions {
  id integer [pk, increment, not null]
  user_id integer [not null]
  token text [unique, not null]
  expires_at "timestamp with time zone" [not null]
  ip_address text
  user_agent text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

Table sponsor_faq {
  id integer [pk, not null]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  items jsonb [not null, default: `'[]'::jsonb`]
}

Table sponsor_tiers {
  id integer [pk, increment, not null]
  name text [unique, not null]
  description text
  max_seats integer [not null, default: `1`]
  max_challenges integer [not null, default: `1`]
  max_judges integer [not null, default: `0`]
  logo_priority integer [not null, default: `0`]
  created_at "timestamp with time zone" [not null, default: `now()`]
}

Table sponsors {
  id integer [pk, increment, not null]
  enterprise_id integer [not null]
  user_id integer
  joined_at "timestamp with time zone" [not null, default: `now()`]
}

Table submissions {
  repo_id integer [not null]
  user_id integer [not null]
  imported_from text [not null, default: `'manual'::text`]
  external_id text
  created_at "timestamp with time zone" [not null, default: `now()`]
  status text [not null, default: `'active'::text`]
  invited_by integer
  responded_at "timestamp with time zone"

  indexes {
  (repo_id, user_id) [pk]
  }
}

Table tickets {
  user_id integer [pk, not null]
  token text [unique, not null]
  issued_at "timestamp with time zone" [not null, default: `now()`]
}

Table time_logs {
  id integer [pk, increment, not null]
  user_id integer
  kind text [not null]
  scanned_at "timestamp with time zone" [not null, default: `now()`]
  scanned_by integer
  notes text
}

Table tv_slots {
  id bigint [pk, not null, default: `nextval('tv_slots_id_seq'::regclass)`]
  label text
  starts_at "timestamp with time zone" [not null]
  ends_at "timestamp with time zone" [not null]
  items jsonb [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

Table universities {
  id integer [pk, increment, not null]
  name text [unique, not null]
  proposed_by integer
  created_at "timestamp with time zone" [not null, default: `now()`]
}

Table user_email_history {
  user_id integer [not null]
  email text [not null]
  recorded_at "timestamp with time zone" [not null, default: `clock_timestamp()`]

  indexes {
  (user_id, email) [pk]
  }

  Note: 'H54 transient cleanup aid. It is deleted with the owning user and never copied to anonymous data.'
}

Table user_invite_link_redemptions {
  id integer [pk, increment, not null]
  link_id integer [not null]
  user_id integer
  email text [not null]
  name text
  redeemed_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
  (link_id, user_id) [unique]
  }
}

Table user_invite_links {
  id integer [pk, increment, not null]
  token text [unique, not null]
  kind text [not null]
  enterprise_id integer
  created_by integer
  role_ids "integer[]" [not null, default: `'{}'::integer[]`, note: 'H8/H10: role ids (roles.id) pre-assigned on link redemption via user_roles.']
  wildcard_authorized boolean [not null, default: `false`, note: 'Durable proof that a wildcard holder authorized this deferred group grant.']
  max_redeems integer
  redeemed_count integer [not null, default: `0`]
  expires_at "timestamp with time zone"
  revoked_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

Table user_roles {
  user_id integer [not null]
  role_id integer [not null]
  assigned_by integer
  assigned_at "timestamp with time zone" [not null, default: `now()`]
  source text [not null, default: `'manual'::text`]

  indexes {
  (user_id, role_id) [pk]
  }
}

Table users {
  id integer [pk, increment, not null]
  email text [unique, not null]
  email_verified boolean [not null, default: `false`]
  image text
  name text
  surname text
  dni text
  badge_id text [unique]
  badge_id_history "text[]" [not null, default: `'{}'::text[]`]
  food_intolerances "integer[]" [not null, default: `'{}'::integer[]`]
  food_intolerance_notes text
  university_id integer
  shirt_size text
  language text [not null, default: `'en'::text`]
  secondary_email text
  secondary_email_verified_at "timestamp with time zone"
  notes text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  anonymized_at "timestamp with time zone"
  dietary_data_state text [not null, default: `'not_provided'::text`]
  ui_prefs jsonb [not null, default: `'{}'::jsonb`]
  account_state text [not null, default: `'active'::text`, note: 'H54 lifecycle gate: identity-bearing writers are rejected after removal_pending commits.']
  removal_action text [note: 'H54 action selected while the user row is locked; retries cannot change the mode.']
  removal_started_at "timestamp with time zone"
  removal_requires_exit boolean [not null, default: `false`, note: 'H54 pending-exit gate: only a valid current-badge or event-end exit may be recorded.']
  removal_idempotency_key text [note: 'H54 transient self-service replay key; it is deleted with the user and is not an identity map.']
  removal_expires_at "timestamp with time zone" [note: 'H54 fixed pending-exit recovery deadline; later sign-ins cannot extend it.']
  is_test_account boolean [not null, default: `false`, note: 'Synthetic reviewer/QA fixture marker; ordinary event surfaces exclude marked rows.']
  badge_assigned_at "timestamp with time zone" [note: 'H23/H54 current physical badge assignment boundary for stale offline scan rejection.']

  Note: 'No role column: role is derived at login from relationships (admin > staff > judge > sponsor > participant). Permissions come from capability groups only (H8).'
}

Table verifications {
  id integer [pk, increment, not null]
  identifier text [not null]
  value text [not null]
  expires_at "timestamp with time zone" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

Table wallet_access_tokens {
  id integer [pk, increment, not null]
  token text [unique, not null]
  user_id integer [not null]
  purpose text [not null]
  expires_at "timestamp with time zone" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
}

Table wallet_pass_devices {
  pass_id integer [not null]
  device_library_identifier text [not null]
  push_token text
  registered_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
  (pass_id, device_library_identifier) [pk]
  }
}

Table wallet_passes {
  id integer [pk, increment, not null]
  user_id integer [not null]
  purpose text [not null]
  platform text [not null]
  serial_number text [not null]
  authentication_token text [not null]
  google_object_id text
  status text [not null, default: `'active'::text`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  last_updated_at "timestamp with time zone" [not null, default: `now()`]
  update_tag text [not null, default: `(((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint)::text`]
}

